# ============================================================
# IT Monitor Pro - Environment variables (TEMPLATE)
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it is in .gitignore).
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# ============================================================

# Application environment: development | testing | production
FLASK_ENV=development

# Flask secret key (used for session signing, etc.)
# REQUIRED in production. Min 32 bytes recommended.
SECRET_KEY=change-me-with-a-strong-random-secret

# JWT signing key (used by Flask-JWT-Extended)
# REQUIRED in production. Min 32 bytes for HS256 (RFC 7518).
JWT_SECRET_KEY=change-me-with-another-strong-random-secret

# Database URL (SQLAlchemy format)
# Dev default: sqlite:///instance/it_monitor.db
# Prod example: postgresql://user:pass@host:5432/it_monitor
DATABASE_URL=sqlite:///instance/it_monitor.db

# CORS allowed origins (comma-separated). Use * for dev only.
CORS_ORIGINS=*